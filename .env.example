NODE_ENV=development
PORT=3000

DATABASE_URL=
DATABASE_URL_POOLED=

REDIS_URL=redis://localhost:6379

ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

WORKER_CONCURRENCY=2

# Minimum spacing between two sends by the same sender, in ms (0 = disabled).
SENDER_MIN_INTERVAL_MS=0

# API authentication is not implemented yet. The REST API refuses every request
# with 401 unless an auth layer populates req.auth before the requireAuth
# middleware. For local development/tests only (ignored when NODE_ENV=production)
# you can impersonate one existing user by id. NEVER set this in production.
# AUTH_DEV_USER_ID=1

# error | warn | http | info (prod) | debug (default)
LOG_LEVEL=debug

LOG_HTTP_IGNORE_PATHS=/health
LOG_EMAIL_PREVIEW_URLS=false

SEED_TEST_DATA=false
ALLOW_NEON_TEST_SEED=false
